{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!**/*.svg"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noNamespaceImport": "warn",
        "noBarrelFile": "off",
        "noJsxPropsBind": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noLeakedRender": "warn",
        "noShadow": "warn",
        "noUnnecessaryConditions": "warn",
        "noEqualsToNull": "off"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsForRole": "warn"
      },
      "correctness": {
        "noNestedComponentDefinitions": "warn"
      },
      "style": {
        "noExportedImports": "off",
        "useDestructuring": "off",
        "noIncrementDecrement": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        // Alphabetizing would scramble cva variant maps and deliberate prop order
        "useSortedKeys": "off",
        "useSortedAttributes": "off",
        "useSortedPackageJson": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/storybook/**",
        "apps/docs/examples/**",
        "apps/docs/components/blocks/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "useImageSize": "off",
            "noNestedComponentDefinitions": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noNamespaceImport": "off",
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      // Demo apps are product screens, not library code: keep a11y and correct-
      // ness checks, but drop style/complexity rules that fight their shape.
      "includes": ["apps/showcase/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "noSvgWithoutTitle": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noShadow": "off",
            "noUnnecessaryConditions": "off",
            "noBitwiseOperators": "off"
          },
          "correctness": {
            "useImageSize": "off",
            "noNestedComponentDefinitions": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noNamespaceImport": "off",
            "noJsxPropsBind": "off",
            "useTopLevelRegex": "off",
            "noImgElement": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useSimplifiedLogicExpression": "off"
          },
          "style": {
            "noNestedTernary": "off",
            "useReadonlyClassProperties": "off",
            "useNumericSeparators": "off",
            "useNumberNamespace": "off",
            "useAtIndex": "off",
            "noNegationElse": "off"
          },
          "nursery": {
            "useSortedClasses": "off"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "useSortedProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.tsx", "**/*.test.ts", "**/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "useAwait": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "apps/docs/scripts/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNestedTernary": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
