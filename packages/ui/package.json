{
  "name": "@neomorphic-ui/react",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "description": "Neomorphic React 19 component library built on Base UI and Tailwind CSS v4.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "exports": {
    "./button": "./src/button.tsx",
    "./surface": "./src/surface.tsx",
    "./utils": "./src/utils.ts",
    "./base.css": "./src/base.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@neomorphic-ui/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.7.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./button": {
        "types": "./dist/button.d.ts",
        "default": "./dist/button.js"
      },
      "./surface": {
        "types": "./dist/surface.d.ts",
        "default": "./dist/surface.js"
      },
      "./utils": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "./base.css": "./src/base.css",
      "./theme.css": "./src/theme.css"
    }
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
