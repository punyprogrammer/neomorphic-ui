{
  "private": true,
  "name": "neomorphic-ui",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "pnpm --filter @neomorphic-react/storybook dev",
    "docs": "pnpm --filter @neomorphic-react/docs dev",
    "showcase": "pnpm --filter @neomorphic-react/showcase dev",
    "site": "pnpm --parallel --filter @neomorphic-react/docs --filter @neomorphic-react/showcase dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "add:component": "node scripts/add-component.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "lint:package": "node scripts/lint-package.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@neomorphic-react/ui && node scripts/check-pack.mjs && node scripts/lint-package.mjs && changeset publish",
    "docs:commit": "node scripts/commit-docs.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "turbo": "^2.11.7",
    "ultracite": "7.12.4"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css}": [
      "ultracite fix"
    ]
  },
  "packageManager": "pnpm@10.34.6"
}
